<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Só números e JSON saem daqui; a formatação em reais é do navegador. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Contêiner pequeno: o GC de estação de trabalho gasta bem menos memória que o de servidor. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Emolumentos.Apresentacao\Emolumentos.Apresentacao.csproj" />
    <ProjectReference Include="..\Emolumentos.Dados\Emolumentos.Dados.csproj" />
    <ProjectReference Include="..\Emolumentos.Dominio\Emolumentos.Dominio.csproj" />
  </ItemGroup>

</Project>
