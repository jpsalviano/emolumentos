<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    O histórico de cálculos é opcional: sem a connection string "Emolumentos", o programa
    calcula normalmente e só o histórico fica desligado. Para ligar, descomente UMA das
    linhas abaixo e ajuste servidor, usuário e senha. As tabelas são criadas na abertura
    do programa, pelas migrations idempotentes da pasta db/.
  -->
  <connectionStrings>
    <!--
    <add name="Emolumentos" providerName="System.Data.SqlClient"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=Emolumentos;Integrated Security=true;Connect Timeout=5" />
    <add name="Emolumentos" providerName="Npgsql"
         connectionString="Host=localhost;Database=emolumentos;Username=emolumentos;Password=...;Timeout=5" />
    -->
  </connectionStrings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
